rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admins are listed in /admins/{uid}, reviewers in /reviewers/{uid}.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isReviewer() {
      return signedIn() && exists(/databases/$(database)/documents/reviewers/$(request.auth.uid));
    }
    function assignedTo(appId) {
      return get(/databases/$(database)/documents/applications/$(appId)).data.get('assignedTo', []);
    }
    // A founder sees a record only if it was created for their email AND they have verified that email.
    function isFounderOf(data) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == data.founderEmail;
    }

    // Startup records — created and edited by admins only. Founders can only read their own.
    match /applications/{appId} {
      allow read: if isAdmin()
                  || isFounderOf(resource.data)
                  || (isReviewer() && request.auth.uid in resource.data.get('assignedTo', []));
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Private admin notes and reviewer scorecards — never visible to founders.
    match /reviews/{appId} {
      allow read, write: if isAdmin();

      match /scores/{scorer} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == scorer);
        allow write: if signedIn() && request.auth.uid == scorer
                     && (isAdmin() || (isReviewer() && request.auth.uid in assignedTo(appId)));
      }
    }

    match /reviewers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // add admins from the Firebase console only
    }
  }
}
